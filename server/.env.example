# ----- Server -----
PORT=5000
JWT_SECRET=dev_secret_change_me

# ----- Data driver -----
# memory  = in-memory demo (no database needed, works out of the box)
# mysql   = MySQL database (set DB_* below)
# supabase = (Phase 2) PostgreSQL via Supabase
DB_DRIVER=memory

# ----- MySQL settings (only used when DB_DRIVER=mysql) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ecommerce42